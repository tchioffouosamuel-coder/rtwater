# Serve React routes when opening a URL directly or refreshing the page.
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_headers.c>
    # Allow Google Identity's popup to communicate with the sign-in page.
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep existing files and directories accessible as usual.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
